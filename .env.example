# 复制为 `.env` 后仅用于本机开发。下列值是公开的本地测试值，不是真实云凭据。
FEEDBACKOS_APP_ENV=local
FEEDBACKOS_DEBUG=true

# PostgreSQL：API 使用完整 URL，Compose 使用拆分后的初始化值。
FEEDBACKOS_DATABASE_URL=postgresql+psycopg://feedbackos:feedbackos_local_only@127.0.0.1:5432/feedbackos
FEEDBACKOS_POSTGRES_DB=feedbackos
FEEDBACKOS_POSTGRES_USER=feedbackos
FEEDBACKOS_POSTGRES_PASSWORD=feedbackos_local_only

# 会话原始密钥只用于签发/校验会话，不得记录到日志或返回给前端。
FEEDBACKOS_SESSION_SECRET=feedbackos_local_only_session_secret_32_chars_minimum
FEEDBACKOS_COOKIE_SECURE=false
FEEDBACKOS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Garage 本地 S3 兼容配置。测试/生产环境改由密钥管理服务注入 OSS 凭据。
FEEDBACKOS_STORAGE_ENDPOINT=http://127.0.0.1:3900
FEEDBACKOS_STORAGE_REGION=garage
FEEDBACKOS_STORAGE_BUCKET=feedbackos-dev-private
FEEDBACKOS_STORAGE_ACCESS_KEY_ID=GK0123456789abcdef0123456789abcdef
FEEDBACKOS_STORAGE_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FEEDBACKOS_STORAGE_ADDRESSING_STYLE=path
FEEDBACKOS_GARAGE_RPC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 上传限制是 API 的权威配置，Web 后续通过 API 获取并展示。
FEEDBACKOS_UPLOAD_MAX_BYTES=10485760
FEEDBACKOS_PREVIEW_ROW_LIMIT=20
