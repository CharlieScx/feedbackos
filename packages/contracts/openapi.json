{
  "components": {
    "schemas": {
      "CreateResource": {
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[^\\x00]+$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateResource",
        "type": "object"
      },
      "Credentials": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "CurrentUser": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email"
        ],
        "title": "CurrentUser",
        "type": "object"
      },
      "CurrentUserResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        },
        "required": [
          "data"
        ],
        "title": "CurrentUserResponse",
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "authentication_failed",
          "access_denied",
          "resource_not_found",
          "request_invalid",
          "file_invalid",
          "conflict",
          "idempotency_conflict",
          "retryable_failure",
          "internal_error"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "title": "Field Errors",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "field_errors"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "field": {
            "title": "Field",
            "type": "string"
          }
        },
        "required": [
          "field",
          "code"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "HealthData": {
        "properties": {
          "service": {
            "const": "feedbackos-api",
            "default": "feedbackos-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
